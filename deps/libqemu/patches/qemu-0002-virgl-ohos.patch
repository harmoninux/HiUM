+/* OHOS：让 virglrenderer.h 暴露 v4 回调——结构体里的 get_egl_display 字段本身
+ * 也在 #ifdef VIRGL_RENDERER_UNSTABLE_APIS 内。qemu 默认按 CALLBACKS_VERSION=2
+ * 编译，v4 分支连字段带代码一起被裁掉，virgl 于是永远走自带 winsys；而 OHOS
+ * 的 libEGL 把「display 是否已初始化」记在线程本地，qemu 的工作线程（MTTCG 的
+ * vCPU 线程）上 eglCreateContext 必失败（实测每次启动 8 次 invalid display
+ * pointer），guest 的 virtio-gpu 命令全部无法完成 → 驱动自旋、宿主被拖死。
+ * 本进程的 GL 上下文由宿主 dgc（renderer_gl_ctx）提供，必须让 virgl 走
+ * external winsys，故在此启用该宏。 */
+#define VIRGL_RENDERER_UNSTABLE_APIS 1
+
 #include <virglrenderer.h>
 
 struct virtio_gpu_virgl_resource {
@@ -1162,6 +1172,13 @@ int virtio_gpu_virgl_init(VirtIOGPU *g)
     }
 #endif
 
+    /* OHOS：不能设 VIRGL_RENDERER_USE_EGL——virglrenderer.c 里「自带 winsys」与
